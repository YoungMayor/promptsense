---
model: gpt-4o
---

{{!-- Header section with role setting --}}
{{role "system"}}

{{#if source_lang}}
  Translate the given text from {{source_lang}} to {{lang}}
{{else}}
  Translate the given text to {{lang}}
{{/if}}

{{#unless skip_summary}}
  Produce a summarized version of the translation.
{{else}}
  Provide the full translation.
{{/unless}}

{{#each destinations}}
  For the destination {{this}}:
  {{prompt "translation-subtask" target=this text=../input_text}}
{{/each}}

{{!-- Expression nesting and helpers --}}
{{#if (and (gt urgency 3) (ne status "completed"))}}
  ALERT: High urgency request detected!
{{/if}}

{{concat "Filename: " (env "USER_DIR" "/tmp/") "output.txt"}}

{{role "user"}}
Input: {{ask "Enter the text to process: "}}

