{
  "name": "promptsense",
  "displayName": "PromptSense",
  "description": "Smart tooling for .prompt files - syntax highlighting, autocomplete, and validation for modern AI workflows.",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "prompt",
    "ai",
    "llm",
    "handlebars",
    "picoschema"
  ],
  "icon": "resources/logo.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "repository": "https://github.com/YoungMayor/promptsense",
  "author": {
    "name": "Aghogho Meyoron",
    "email": "youngmayor.dev@gmail.com",
    "url": "https://aghogho.mayrlabs.com"
  },
  "publisher": "mayrlabs",
  "contributes": {
    "languages": [
      {
        "id": "promptsense",
        "aliases": [
          "PromptSense",
          "promptsense"
        ],
        "extensions": [
          ".prompt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "promptsense",
        "scopeName": "source.prompt",
        "path": "./syntaxes/prompt.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "promptsense.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "prepare": "husky",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  },
  "license": "MIT"
}
